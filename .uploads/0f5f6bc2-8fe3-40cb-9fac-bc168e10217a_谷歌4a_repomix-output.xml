// Package api 暴露 OpenAI 兼容的 HTTP 端点。
//
// 里程碑1 只实现非流式 /v1/chat/completions（+ /、/health、/v1/models）。
// 真流式 SSE、图像/TTS/embeddings、Gemini 原生端点留待后续里程碑。
package api

import (
	"context"
	"encoding/json"
	"io"
	"log"
	"net/http"
	"runtime/debug"
	"strconv"
	"strings"
	"time"

