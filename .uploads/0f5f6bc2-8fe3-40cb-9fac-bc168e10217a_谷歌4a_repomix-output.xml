func TestExtractAudioResponseEmpty(t *testing.T) {
	result := makeResult([]any{
		map[string]any{"text": "no audio here"},
	})
	audio := extractAudioResponse(result)
	if audio.Data != "" || audio.MimeType != "" {
		t.Errorf("无音频应返回空 AudioData，实际 %+v", audio)
	}
